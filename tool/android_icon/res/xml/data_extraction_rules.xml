<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/audio/" />
        <exclude domain="root" path="app_flutter/videos/" />
        <exclude domain="root" path="app_flutter/_restore_pendiente/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/audio/" />
        <exclude domain="root" path="app_flutter/videos/" />
        <exclude domain="root" path="app_flutter/_restore_pendiente/" />
    </device-transfer>
</data-extraction-rules>
