<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/kumo_widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kumo 🐱"
        android:textColor="#FF2B2B2B"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Toca para abrir tus cuadernos"
        android:textColor="#FF5A5A5A"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/kumo_widget_button"
            android:text="✏️ Nota"
            android:textColor="#FF2B2B2B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_record"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/kumo_widget_button"
            android:text="🎙️ Grabar"
            android:textColor="#FF2B2B2B"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
